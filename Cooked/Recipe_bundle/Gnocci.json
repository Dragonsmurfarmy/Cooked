        { "id": "C3EB2345-1234-4567-8901-A1B2C3D4E5F3", "name": "česneku (na plátky)", "amount": 5, "unit": "stroužků" },
        { "id": "D4EB2345-1234-4567-8901-A1B2C3D4E5F4", "name": "mraženého nebo čerstvého listového špenátu", "amount": 300, "unit": "g" },
