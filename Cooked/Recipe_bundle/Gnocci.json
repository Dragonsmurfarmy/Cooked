      ],
      "instructions": [
        { "id": "110F2B4C-6789-4D2A-9876-1234567890AB", "text": "Uvařte gnocchi v osolené vodě podle návodu, dokud nevyplavou." },
        { "id": "120F2B4C-6789-4D2A-9876-1234567890AB", "text": "Na pánvi rozpusťte máslo a krátce orestujte plátky česneku." },
        { "id": "130F2B4C-6789-4D2A-9876-1234567890AB", "text": "Přidejte špenát a nechte ho zredukovat." },
        { "id": "140F2B4C-6789-4D2A-9876-1234567890AB", "text": "Vlijte smetanu, přisypte parmazán a omáčku nechte mírně zhoustnout." },
        { "id": "150F2B4C-6789-4D2A-9876-1234567890AB", "text": "Do hotové omáčky vmíchejte uvařené gnocchi a prohřejte." }
