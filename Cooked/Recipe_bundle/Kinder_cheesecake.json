      "instructions": [
        { "id": "220F2B4C-6789-4D2A-9876-1234567890AC", "text": "Všechno postupně smíchejte a jako poslední zamíchejte rozpuštěnou Kinder čokoládu. Všechno míchejte na nízkých otáčkách, aby se směs nepřešlehala." },
        { "id": "230F2B4C-6789-4D2A-9876-1234567890AD", "text": "Směs nalijte na korpus a dejte péct na 160 °C na 50 minut s vodní lázní." }
        { "id": "230F2B4C-6789-4D2A-9876-1234567890AD", "text": "Cheesecake nechte úplně vychladnout v pootevřené troubě." }
